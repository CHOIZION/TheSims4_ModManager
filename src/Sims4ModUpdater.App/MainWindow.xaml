<Window x:Class="Sims4ModUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sims4ModUpdater.ViewModels"
        Title="Sims 4 Mod Auto Updater (.NET Edition)"
        Width="1360"
        Height="840"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="SIMS 4 MOD UPDATER" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="모드 자동 업데이터" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Tab Radio Buttons -->
                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                 Content="📦  모드 탐색기"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EqToBool}, ConverterParameter=Explorer}" />
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                 Content="🗂️  유형별 분류"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EqToBool}, ConverterParameter=Categories}" />
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                 Content="🔄  업데이트 센터"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EqToBool}, ConverterParameter=Updates}" />
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                 Content="💾  백업 &amp; 복원"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EqToBool}, ConverterParameter=Backups}" />
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                 Content="🔬  진단 리포트"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EqToBool}, ConverterParameter=Diagnostics}" />
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                 Content="⚙️  카탈로그 &amp; 설정"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EqToBool}, ConverterParameter=Settings}" />
                </StackPanel>

                <!-- Sidebar Quick Summary -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="현재 Mods 폴더" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ActiveModsFolderDisplay}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ActiveModsFolderDisplay}"
                                   Margin="0,3,0,10" />
                        <Button Content="↻  폴더 다시 스캔"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshScanCommand}"
                                Margin="0,0,0,6" />
                        <Button Content="전체 업데이트 조회"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CheckAllUpdatesCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Workspace Content -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="22,18">

            <!-- TAB 1: EXPLORER -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:MainTab.Explorer}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="모드 탐색기 &amp; 제작자 정리" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="제작자별 MO2 접기/펼치기 분류, Mods 폴더 자동 정리, DBPF·PYC 내부 URL, 중복 설치 및 깊이 경고를 한눈에 확인합니다."
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📁 폴더 맞추기 (제작자별 자동 정리)"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenOrganizeByCreatorCommand}"
                                Margin="0,0,8,0"
                                ToolTip="분류된 제작자 기준으로 Sims 4 Mods 폴더의 실제 파일/폴더를 안전하게 정리합니다" />
                        <Button Content="탐색기에서 열기" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenInExplorerCommand}" />
                    </StackPanel>
                </Grid>

                <!-- KPI Cards -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="총 모드 파일" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding TotalFileCount}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Text="package + ts4script 전체" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text=".package / .ts4script" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding PackageCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                <TextBlock Text="  /  " FontSize="18" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ScriptCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="일반 리소스 / 스크립트 코어" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="점검 대상 유닛" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding UpdatableUnitCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding FolderCount, StringFormat='1단계 폴더 {0}개 포함'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="업데이트 발견" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding UpdateNeededCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding CheckedCount, StringFormat='최근 조회 완료 {0}개'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Depth Warning Banner -->
                <Border Grid.Row="2"
                        Visibility="{Binding DepthWarnings.Count, Converter={StaticResource NullOrEmptyToVis}}"
                        Background="#3B2912"
                        BorderBrush="#B45309"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,9"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding DepthWarnings.Count, StringFormat='⚠️ 설치 깊이 초과 경고: 하위 2단계 이상 깊이에 위치한 .ts4script 파일이 {0}개 있습니다 (게임 미인식 위험)'}"
                                   FontWeight="SemiBold" Foreground="#FCD34D" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding DepthWarnings}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#FDE68A" Margin="10,1,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Master/Detail List & Inspector -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ExplorerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="검색..."
                                     ToolTip="모드명, 제작자, 폴더명 또는 파일명으로 필터링"
                                     Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource FilterChipRadioStyle}"
                                             Content="제작자별 묶기"
                                             GroupName="ExpView"
                                             IsChecked="{Binding ExplorerView, Converter={StaticResource EqToBool}, ConverterParameter=ByCreator}" />
                                <RadioButton Style="{StaticResource FilterChipRadioStyle}"
                                             Content="개별 모드"
                                             GroupName="ExpView"
                                             IsChecked="{Binding ExplorerView, Converter={StaticResource EqToBool}, ConverterParameter=Units}" />
                                <RadioButton Style="{StaticResource FilterChipRadioStyle}"
                                             Content="1단계 폴더"
                                             GroupName="ExpView"
                                             IsChecked="{Binding ExplorerView, Converter={StaticResource EqToBool}, ConverterParameter=Folders}" />
                            </StackPanel>
                        </Grid>

                        <!-- MO2 Creator Toolbar -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExplorerView}" Value="{x:Static vm:ExplorerViewMode.ByCreator}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExplorerView}" Value="{x:Static vm:ExplorerViewMode.Units}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExplorerView}" Value="{x:Static vm:ExplorerViewMode.ByCreator}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="▼ 모두 펼치기"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="9,4"
                                            FontSize="11.5"
                                            Command="{Binding ExpandAllCreatorsCommand}"
                                            Margin="0,2,6,2" />
                                    <Button Content="▶ 모두 접기"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="9,4"
                                            FontSize="11.5"
                                            Command="{Binding CollapseAllCreatorsCommand}"
                                            Margin="0,2,8,2" />
                                    <RadioButton Style="{StaticResource FilterChipRadioStyle}"
                                                 Content="🖼️ 썸네일 보기"
                                                 Padding="9,4"
                                                 FontSize="11.5"
                                                 GroupName="CreatorThumbMode"
                                                 Margin="0,2,6,2"
                                                 IsChecked="{Binding CreatorDisplay, Converter={StaticResource EqToBool}, ConverterParameter=ThumbnailGrid}" />
                                    <RadioButton Style="{StaticResource FilterChipRadioStyle}"
                                                 Content="☰ 썸네일 간편화"
                                                 Padding="9,4"
                                                 FontSize="11.5"
                                                 GroupName="CreatorThumbMode"
                                                 Margin="0,2,10,2"
                                                 IsChecked="{Binding CreatorDisplay, Converter={StaticResource EqToBool}, ConverterParameter=CompactList}" />
                                </StackPanel>
                                <CheckBox Content="미분류만 보기"
                                          IsChecked="{Binding ShowUnknownCreatorOnly}"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Margin="0,2,12,2" />
                                <CheckBox Content="{Binding DuplicateFilterLabel}"
                                          IsChecked="{Binding ShowDuplicateModsOnly}"
                                          Foreground="#FCA5A5"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Margin="0,2,8,2" />
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="메타데이터 제작자 분석 중..."
                                           Visibility="{Binding IsResolvingCreators, Converter={StaticResource BoolToVis}}"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="{Binding CreatorGroupCount, StringFormat='그룹 {0}개'}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExplorerView}" Value="{x:Static vm:ExplorerViewMode.ByCreator}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- MO2 Collapsible Creator Group Tree View -->
                        <Border Grid.Row="2"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExplorerView}" Value="{x:Static vm:ExplorerViewMode.ByCreator}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ItemsControl ItemsSource="{Binding FilteredCreatorGroups}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Standard"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer Focusable="False"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="True"
                                                      Padding="{TemplateBinding Padding}">
                                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Style="{StaticResource CreatorExpanderStyle}"
                                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CreatorName}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsUnknownGroup}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningAmberBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Border Background="#1B2A26"
                                                                    BorderBrush="#10B981"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasOverrides, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding OverrideBadge}" FontSize="10.5" Foreground="{StaticResource AccentPrimaryBrush}" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Background="#3B1219"
                                                                    BorderBrush="#7F1D1D"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,1"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding DuplicateSummaryBadge}" FontSize="10.5" Foreground="#FCA5A5" FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding SummaryBadge}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,10,0" />
                                                        <Button Grid.Column="2"
                                                                Content="이름변경/합치기"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="8,3"
                                                                FontSize="11"
                                                                Command="{Binding DataContext.RenameCreatorGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Expander.Header>

                                                <Border Background="#151923" CornerRadius="0,0,7,7" Padding="6,4">
                                                    <Grid>
                                                        <!-- S4MM Style Thumbnail Card Grid -->
                                                        <ItemsControl ItemsSource="{Binding Mods}"
                                                                      Visibility="{Binding DataContext.IsThumbnailCreatorView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" Margin="2,4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Margin="4"
                                                                            Padding="0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            Command="{Binding DataContext.SelectExplorerModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Button.ContextMenu>
                                                                            <ContextMenu>
                                                                                <MenuItem Header="제작자 지정"
                                                                                          Command="{Binding PlacementTarget.Tag.AssignCreatorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                                <MenuItem Header="이 모드만 업데이트 조회"
                                                                                          Command="{Binding PlacementTarget.Tag.CheckSingleModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                            </ContextMenu>
                                                                        </Button.ContextMenu>
                                                                        <Button.ToolTip>
                                                                            <ToolTip>
                                                                                <StackPanel MaxWidth="320">
                                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                                                                                    <TextBlock Text="{Binding PrimaryFileName}" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                    <TextBlock Text="{Binding FolderName, StringFormat='폴더: {0}'}" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" />
                                                                                    <TextBlock Text="{Binding FileCountBadge, StringFormat='구성: {0}'}" Foreground="#38BDF8" FontSize="11" Margin="0,2,0,0" />
                                                                                </StackPanel>
                                                                            </ToolTip>
                                                                        </Button.ToolTip>
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="ThumbCardBd"
                                                                                        Width="124"
                                                                                        Height="148"
                                                                                        Background="#222630"
                                                                                        BorderBrush="#2F3543"
                                                                                        BorderThickness="1.2"
                                                                                        CornerRadius="8">
                                                                                    <Grid>
                                                                                        <Grid.RowDefinitions>
                                                                                            <RowDefinition Height="98" />
                                                                                            <RowDefinition Height="*" />
                                                                                        </Grid.RowDefinitions>
                                                                                        <Border Grid.Row="0"
                                                                                                Margin="6,6,6,3"
                                                                                                Background="#191D25"
                                                                                                CornerRadius="6"
                                                                                                ClipToBounds="True">
                                                                                            <Grid>
                                                                                                <Image Source="{Binding ThumbnailImage}"
                                                                                                       Stretch="Uniform"
                                                                                                       VerticalAlignment="Center"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                                                                                <Grid Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                                                                    <TextBlock Text="{}{}"
                                                                                                               FontSize="24"
                                                                                                               FontWeight="Bold"
                                                                                                               Foreground="#D1D5DB"
                                                                                                               HorizontalAlignment="Center"
                                                                                                               VerticalAlignment="Center"
                                                                                                               Visibility="{Binding IsScriptUnit, Converter={StaticResource BoolToVis}}" />
                                                                                                    <Viewbox Width="28"
                                                                                                             Height="28"
                                                                                                             HorizontalAlignment="Center"
                                                                                                             VerticalAlignment="Center"
                                                                                                             Visibility="{Binding IsScriptUnit, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                                                                        <Path Width="24"
                                                                                                              Height="24"
                                                                                                              Stretch="Uniform"
                                                                                                              Stroke="#D1D5DB"
                                                                                                              StrokeThickness="1.8"
                                                                                                              StrokeStartLineCap="Round"
                                                                                                              StrokeEndLineCap="Round"
                                                                                                              StrokeLineJoin="Round"
                                                                                                              Data="M 12,2 L 21,7 L 21,17 L 12,22 L 3,17 L 3,7 Z M 12,12 L 12,22 M 12,12 L 21,7 M 12,12 L 3,7" />
                                                                                                    </Viewbox>
                                                                                                </Grid>
                                                                                                <Border HorizontalAlignment="Right"
                                                                                                        VerticalAlignment="Top"
                                                                                                        Margin="4"
                                                                                                        Padding="5,1"
                                                                                                        CornerRadius="4"
                                                                                                        Background="#991B1B"
                                                                                                        BorderBrush="#EF4444"
                                                                                                        BorderThickness="1"
                                                                                                        Visibility="{Binding HasDuplicateWarning, Converter={StaticResource BoolToVis}}">
                                                                                                    <TextBlock Text="중복" FontSize="9.5" FontWeight="Bold" Foreground="#FEF2F2" />
                                                                                                </Border>
                                                                                            </Grid>
                                                                                        </Border>
                                                                                        <TextBlock Grid.Row="1"
                                                                                                   Text="{Binding Name}"
                                                                                                   FontSize="11"
                                                                                                   FontWeight="Medium"
                                                                                                   Foreground="#E5E7EB"
                                                                                                   TextAlignment="Center"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   TextWrapping="Wrap"
                                                                                                   LineHeight="14"
                                                                                                   MaxHeight="34"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="6,0,6,5" />
                                                                                    </Grid>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="ThumbCardBd" Property="Background" Value="#2A303D" />
                                                                                        <Setter TargetName="ThumbCardBd" Property="BorderBrush" Value="#4B5563" />
                                                                                    </Trigger>
                                                                                    <DataTrigger Binding="{Binding IsSelectedInExplorer}" Value="True">
                                                                                        <Setter TargetName="ThumbCardBd" Property="Background" Value="#233245" />
                                                                                        <Setter TargetName="ThumbCardBd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                                                                        <Setter TargetName="ThumbCardBd" Property="BorderThickness" Value="1.8" />
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Compact List Rows -->
                                                        <ItemsControl ItemsSource="{Binding Mods}"
                                                                      Visibility="{Binding DataContext.IsCompactCreatorView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border x:Name="ChildRowBorder"
                                                                            CornerRadius="5"
                                                                            Margin="0,1"
                                                                            BorderThickness="1"
                                                                            BorderBrush="Transparent"
                                                                            Background="Transparent">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelectedInExplorer}" Value="True">
                                                                                        <Setter Property="Background" Value="#1E2D3E" />
                                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Button Grid.Column="0"
                                                                                    Command="{Binding DataContext.SelectExplorerModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Cursor="Hand"
                                                                                    HorizontalContentAlignment="Stretch">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="RowClickBd" Background="Transparent" Padding="8,6" CornerRadius="4">
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="1.5*" />
                                                                                                    <ColumnDefinition Width="1.05*" />
                                                                                                    <ColumnDefinition Width="0.7*" />
                                                                                                    <ColumnDefinition Width="Auto" MinWidth="76" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                                                    <TextBlock Text="{Binding CreatorSourceLabel, StringFormat='인식: {0}'}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                                                                                </StackPanel>
                                                                                                <TextBlock Grid.Column="1" Text="{Binding FolderName}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                                                                <TextBlock Grid.Column="2" Text="{Binding LocalVersionDisplay}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                                                    <Border Background="#3B1219"
                                                                                                            BorderBrush="#7F1D1D"
                                                                                                            BorderThickness="1"
                                                                                                            CornerRadius="4"
                                                                                                            Padding="5,1"
                                                                                                            Margin="0,0,6,0"
                                                                                                            Visibility="{Binding HasDuplicateWarning, Converter={StaticResource BoolToVis}}">
                                                                                                        <TextBlock Text="중복" FontSize="10" Foreground="#FCA5A5" FontWeight="SemiBold" />
                                                                                                    </Border>
                                                                                                    <TextBlock Text="{Binding FileCountBadge}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                                                                                                </StackPanel>
                                                                                            </Grid>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="RowClickBd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                            <Button Grid.Column="1"
                                                                                    Content="제작자 지정"
                                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                                    Padding="8,3"
                                                                                    FontSize="11"
                                                                                    Margin="4,0,6,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Command="{Binding DataContext.AssignCreatorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </Border>

                        <!-- Unit DataGrid -->
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding FilteredExplorerUnits}"
                                  SelectedItem="{Binding SelectedExplorerUnit}"
                                  IsReadOnly="True">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExplorerView}" Value="{x:Static vm:ExplorerViewMode.Units}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="모드 유닛명" Binding="{Binding Name}" Width="1.5*" />
                                <DataGridTextColumn Header="제작자" Binding="{Binding CreatorName}" Width="1.05*" />
                                <DataGridTextColumn Header="설치 폴더" Binding="{Binding FolderName}" Width="1.05*" />
                                <DataGridTextColumn Header="로컬 버전" Binding="{Binding LocalVersionDisplay}" Width="0.8*" />
                                <DataGridTextColumn Header="분류" Binding="{Binding ModType}" Width="0.7*" />
                                <DataGridTextColumn Header="구성" Binding="{Binding FileCountBadge}" Width="0.65*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Folder DataGrid -->
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding FilteredExplorerFolders}"
                                  SelectedItem="{Binding SelectedExplorerFolder}"
                                  IsReadOnly="True">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExplorerView}" Value="{x:Static vm:ExplorerViewMode.Folders}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="폴더명" Binding="{Binding Name}" Width="1.7*" />
                                <DataGridTextColumn Header="구분" Binding="{Binding CategoryBadge}" Width="1.2*" />
                                <DataGridTextColumn Header="Package" Binding="{Binding PackageCount}" Width="0.6*" />
                                <DataGridTextColumn Header="Script" Binding="{Binding ScriptCount}" Width="0.6*" />
                                <DataGridTextColumn Header="하위폴더" Binding="{Binding SubdirCount}" Width="0.6*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Right Inspector Drawer -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="선택 항목 상세 인스펙터" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <StackPanel Visibility="{Binding SelectedExplorerUnit, Converter={StaticResource NullOrEmptyToVis}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="72"
                                                Height="72"
                                                Margin="0,0,12,0"
                                                CornerRadius="8"
                                                Background="#191D25"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                Visibility="{Binding SelectedUnitThumbnail, Converter={StaticResource NullOrEmptyToVis}}">
                                            <Image Source="{Binding SelectedUnitThumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedExplorerUnit.Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedExplorerUnit.PrimaryFileName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="제작자:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SelectedExplorerUnit.CreatorName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedExplorerUnit.CreatorSourceLabel}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="이 모드만 업데이트 조회" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CheckSingleModCommand}" CommandParameter="{Binding SelectedExplorerUnit}" Margin="0,0,8,6" />
                                        <Button Content="제작자 변경" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AssignCreatorCommand}" CommandParameter="{Binding SelectedExplorerUnit}" Margin="0,0,8,6" />
                                        <Button Content="URL 고정/수정" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PinUrlCommand}" CommandParameter="{Binding SelectedExplorerUnit}" Margin="0,0,8,6" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Binary/YAML Metadata Card -->
                                <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="내부 추출 메타데이터 (DBPF / YAML / PYC)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding SelectedUnitMetadata.ManifestName, StringFormat='Manifest명: {0}'}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" Visibility="{Binding SelectedUnitMetadata.ManifestName, Converter={StaticResource NullOrEmptyToVis}}" />
                                        <TextBlock Text="{Binding SelectedMetadataCreatorsText, StringFormat='제작자: {0}'}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding SelectedUnitMetadata.Version, StringFormat='감지된 내부 버전: {0}'}" FontSize="12" Margin="0,0,0,3" Visibility="{Binding SelectedUnitMetadata.Version, Converter={StaticResource NullOrEmptyToVis}}" />
                                        <TextBlock Text="{Binding SelectedMetadataDisplayNamesText, StringFormat='표시명: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding SelectedMetadataModulesText, StringFormat='모듈/튜닝: {0}'}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <TextBlock Text="파일 내장 공식 URL:" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedMetadataUrlsText}" FontSize="11.5" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Duplicate Detection Card -->
                                <Border Background="#3B1E22" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                        Visibility="{Binding SelectedDuplicateInfo.Duplicates, Converter={StaticResource NullOrEmptyToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="⚠️ 동일 파일명 중복 설치 감지됨" FontSize="12.5" FontWeight="SemiBold" Foreground="#FCA5A5" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding SelectedDuplicateInfo.Duplicates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2,0,4">
                                                        <TextBlock Text="{Binding FileName, StringFormat='중복: {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FECACA" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding OriginalPath, StringFormat='기준: {0}'}" FontSize="10.5" Foreground="#FCA5A5" TextWrapping="Wrap" Opacity="0.9" />
                                                        <TextBlock Text="{Binding DuplicatePath, StringFormat='중복 위치: {0}'}" FontSize="10.5" Foreground="#FCA5A5" TextWrapping="Wrap" Opacity="0.9" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Included Files List -->
                                <TextBlock Text="{Binding SelectedInspectorFiles.Count, StringFormat='포함된 파일 목록 ({0}개)'}" FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,6" />
                                <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="6" Padding="8" MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SelectedInspectorFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB: MOD CATEGORIES -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:MainTab.Categories}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="모드 유형별 자동 분류" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding CategoryAnalysisSummaryText}"
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="새로고침" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshScanCommand}" Margin="0,0,8,0" />
                        <Button Content="현재 표시 목록 업데이트 조회" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CheckFilteredCategoryCommand}" />
                    </StackPanel>
                </Grid>

                <!-- 4 Clickable Category KPI Cards -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                    <Button Command="{Binding ToggleCategoryKpiCommand}" CommandParameter="ScriptCoreMod" Margin="0,0,10,0" Cursor="Hand" ToolTip="클릭하여 1번 카테고리만 필터링 / 해제">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="14,12" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding CategoryFilter}" Value="{x:Static vm:CategoryFilterMode.ScriptCoreMod}">
                                                    <Setter TargetName="CardBd" Property="Background" Value="#122B24" />
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="1번. ts4script 기반 핵심 모드" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CategoryScriptCount}" FontSize="24" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0" />
                            <TextBlock Text="Python 스크립트 엔진 · MCCC / WW 등" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleCategoryKpiCommand}" CommandParameter="XmlGameplayMod" Margin="0,0,10,0" Cursor="Hand" ToolTip="클릭하여 2번 카테고리만 필터링 / 해제">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="14,12" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding CategoryFilter}" Value="{x:Static vm:CategoryFilterMode.XmlGameplayMod}">
                                                    <Setter TargetName="CardBd" Property="Background" Value="#122B24" />
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="2번. XML 튜닝 기반 게임 플레이" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CategoryXmlCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="특성·버프·상호작용 XML + STBL 번역" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleCategoryKpiCommand}" CommandParameter="ObjectModAndCc" Margin="0,0,10,0" Cursor="Hand" ToolTip="클릭하여 3번 카테고리만 필터링 / 해제">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="14,12" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding CategoryFilter}" Value="{x:Static vm:CategoryFilterMode.ObjectModAndCc}">
                                                    <Setter TargetName="CardBd" Property="Background" Value="#122B24" />
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="3번. 작동 오브젝트 + CC" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CategoryObjectCcCount}" FontSize="24" FontWeight="Bold" Foreground="#60A5FA" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ExcludedCcPackageCount, StringFormat='기능 오브젝트·CAS·가구 (CC폴더 {0}개 별도)'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleCategoryKpiCommand}" CommandParameter="AnimationAndPose" Cursor="Hand" ToolTip="클릭하여 4번 카테고리만 필터링 / 해제">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="14,12" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding CategoryFilter}" Value="{x:Static vm:CategoryFilterMode.AnimationAndPose}">
                                                    <Setter TargetName="CardBd" Property="Background" Value="#122B24" />
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="4번. 애니메이션 / 포즈" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CategoryAnimationCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="WW 애니·댄스·포즈팩·CLIP 모션" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Search & Filter Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding CategorySearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="모드명, 제작자, 폴더명, 세부 분류 또는 DBPF 근거로 검색"
                             Margin="0,0,10,0" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="전체" GroupName="CatFilter" IsChecked="{Binding CategoryFilter, Converter={StaticResource EqToBool}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="1. ts4script 코어" GroupName="CatFilter" IsChecked="{Binding CategoryFilter, Converter={StaticResource EqToBool}, ConverterParameter=ScriptCoreMod}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="2. XML 튜닝 · 번역" GroupName="CatFilter" IsChecked="{Binding CategoryFilter, Converter={StaticResource EqToBool}, ConverterParameter=XmlGameplayMod}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="3. 작동 오브젝트 + CC" GroupName="CatFilter" IsChecked="{Binding CategoryFilter, Converter={StaticResource EqToBool}, ConverterParameter=ObjectModAndCc}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="4. 애니메이션 / 포즈" GroupName="CatFilter" IsChecked="{Binding CategoryFilter, Converter={StaticResource EqToBool}, ConverterParameter=AnimationAndPose}" />
                    </WrapPanel>
                    <TextBlock Grid.Column="2" Text="{Binding CategoryFilteredCountLabel}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Master/Detail: Virtualized DataGrid + Category Inspector -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding FilteredCategoryMods}"
                              SelectedItem="{Binding SelectedCategoryMod, Mode=TwoWay}"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="유형 대분류" Width="1.0*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="7,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#252C3D" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FunctionalCategory}" Value="{x:Static models:ModFunctionalCategory.ScriptCoreMod}"
                                                                     xmlns:models="clr-namespace:Sims4ModUpdater.Core.Models;assembly=Sims4ModUpdater.Core">
                                                            <Setter Property="Background" Value="#143328" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FunctionalCategory}" Value="{x:Static models:ModFunctionalCategory.XmlGameplayMod}"
                                                                     xmlns:models="clr-namespace:Sims4ModUpdater.Core.Models;assembly=Sims4ModUpdater.Core">
                                                            <Setter Property="Background" Value="#132E3A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FunctionalCategory}" Value="{x:Static models:ModFunctionalCategory.ObjectModAndCc}"
                                                                     xmlns:models="clr-namespace:Sims4ModUpdater.Core.Models;assembly=Sims4ModUpdater.Core">
                                                            <Setter Property="Background" Value="#1B2A44" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FunctionalCategory}" Value="{x:Static models:ModFunctionalCategory.AnimationAndPose}"
                                                                     xmlns:models="clr-namespace:Sims4ModUpdater.Core.Models;assembly=Sims4ModUpdater.Core">
                                                            <Setter Property="Background" Value="#372814" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding FunctionalCategoryShortLabel}" FontSize="11.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FunctionalCategory}" Value="{x:Static models:ModFunctionalCategory.ScriptCoreMod}"
                                                                         xmlns:models="clr-namespace:Sims4ModUpdater.Core.Models;assembly=Sims4ModUpdater.Core">
                                                                <Setter Property="Foreground" Value="#34D399" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FunctionalCategory}" Value="{x:Static models:ModFunctionalCategory.XmlGameplayMod}"
                                                                         xmlns:models="clr-namespace:Sims4ModUpdater.Core.Models;assembly=Sims4ModUpdater.Core">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FunctionalCategory}" Value="{x:Static models:ModFunctionalCategory.ObjectModAndCc}"
                                                                         xmlns:models="clr-namespace:Sims4ModUpdater.Core.Models;assembly=Sims4ModUpdater.Core">
                                                                <Setter Property="Foreground" Value="#93C5FD" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FunctionalCategory}" Value="{x:Static models:ModFunctionalCategory.AnimationAndPose}"
                                                                         xmlns:models="clr-namespace:Sims4ModUpdater.Core.Models;assembly=Sims4ModUpdater.Core">
                                                                <Setter Property="Foreground" Value="#FCD34D" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="세부 분류" Binding="{Binding FunctionalSubCategory}" Width="1.05*" />
                            <DataGridTextColumn Header="모드 유닛명" Binding="{Binding Name}" Width="1.45*" />
                            <DataGridTextColumn Header="제작자" Binding="{Binding CreatorName}" Width="0.9*" />
                            <DataGridTextColumn Header="설치 폴더" Binding="{Binding FolderName}" Width="0.85*" />
                            <DataGridTextColumn Header="구성" Binding="{Binding FileCountBadge}" Width="0.55*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Category Inspector Drawer -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="선택 모드 분류 상세" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Text="왼쪽 목록에서 모드를 선택하면 DBPF/스크립트 분류 근거와 상세 정보가 표시됩니다."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding SelectedCategoryMod, Converter={StaticResource NullOrEmptyToVis}, ConverterParameter=Invert}" />

                                <StackPanel Visibility="{Binding SelectedCategoryMod, Converter={StaticResource NullOrEmptyToVis}}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="80" Height="80"
                                                Margin="0,0,12,0"
                                                CornerRadius="8"
                                                Background="#191D25"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                Visibility="{Binding SelectedCategoryThumbnail, Converter={StaticResource NullOrEmptyToVis}}">
                                            <Image Source="{Binding SelectedCategoryThumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedCategoryMod.Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedCategoryMod.PrimaryFileName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,4" TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <Border Background="#1B3238" CornerRadius="4" Padding="7,2" Margin="0,0,6,2">
                                                    <TextBlock Text="{Binding SelectedCategoryMod.FunctionalCategoryShortLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" />
                                                </Border>
                                                <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding SelectedCategoryMod.FunctionalSubCategory}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="제작자:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SelectedCategoryMod.CreatorName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedCategoryMod.CreatorSourceLabel}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="이 모드만 업데이트 조회" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CheckSingleModCommand}" CommandParameter="{Binding SelectedCategoryMod}" Margin="0,0,8,6" />
                                        <Button Content="모드 탐색기에서 보기" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenModInExplorerTabCommand}" CommandParameter="{Binding SelectedCategoryMod}" Margin="0,0,8,6" />
                                        <Button Content="제작자 변경" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AssignCreatorCommand}" CommandParameter="{Binding SelectedCategoryMod}" Margin="0,0,8,6" />
                                        <Button Content="URL 고정/수정" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PinUrlCommand}" CommandParameter="{Binding SelectedCategoryMod}" Margin="0,0,8,6" />
                                    </WrapPanel>

                                    <!-- Classification Evidence Card -->
                                    <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="분류 근거 (DBPF 리소스 / 스니펫)" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding SelectedCategoryMod.FunctionalCategoryFullLabel, StringFormat='대분류: {0}'}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" />
                                            <TextBlock Text="{Binding SelectedCategoryMod.FunctionalSubCategory, StringFormat='세부 유형: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                            <TextBlock Text="{Binding SelectedCategoryMod.FunctionalReason, StringFormat='판별 근거: {0}'}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Metadata Card -->
                                    <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="내부 추출 메타데이터 (DBPF / YAML / PYC)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding SelectedCategoryMetadata.ManifestName, StringFormat='Manifest명: {0}'}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" Visibility="{Binding SelectedCategoryMetadata.ManifestName, Converter={StaticResource NullOrEmptyToVis}}" />
                                            <TextBlock Text="{Binding SelectedCategoryMetadataCreatorsText, StringFormat='제작자: {0}'}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" />
                                            <TextBlock Text="{Binding SelectedCategoryMetadata.Version, StringFormat='감지된 내부 버전: {0}'}" FontSize="12" Margin="0,0,0,3" Visibility="{Binding SelectedCategoryMetadata.Version, Converter={StaticResource NullOrEmptyToVis}}" />
                                            <TextBlock Text="{Binding SelectedCategoryMetadataDisplayNamesText, StringFormat='표시명: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                            <TextBlock Text="{Binding SelectedCategoryMetadataModulesText, StringFormat='모듈/튜닝: {0}'}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <TextBlock Text="파일 내장 공식 URL:" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding SelectedCategoryMetadataUrlsText}" FontSize="11.5" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Duplicate Detection Card -->
                                    <Border Background="#3B1E22" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                            Visibility="{Binding SelectedCategoryDuplicateInfo.Duplicates, Converter={StaticResource NullOrEmptyToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="⚠️ 동일 파일명 중복 설치 감지됨" FontSize="12.5" FontWeight="SemiBold" Foreground="#FCA5A5" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding SelectedCategoryDuplicateInfo.Duplicates}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2,0,4">
                                                            <TextBlock Text="{Binding FileName, StringFormat='중복: {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FECACA" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding OriginalPath, StringFormat='기준: {0}'}" FontSize="10.5" Foreground="#FCA5A5" TextWrapping="Wrap" Opacity="0.9" />
                                                            <TextBlock Text="{Binding DuplicatePath, StringFormat='중복 위치: {0}'}" FontSize="10.5" Foreground="#FCA5A5" TextWrapping="Wrap" Opacity="0.9" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Included Files List -->
                                    <TextBlock Text="{Binding SelectedCategoryInspectorFiles.Count, StringFormat='포함된 파일 목록 ({0}개)'}" FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,6" />
                                    <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="6" Padding="8" MaxHeight="200">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedCategoryInspectorFiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB 2: UPDATES CENTER -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:MainTab.Updates}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header + Action Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="업데이트 센터" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding UpdatesScopeSummaryText}"
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="선택 항목 조회" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CheckSelectedUpdatesCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding CheckAllUpdatesButtonLabel}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CheckAllUpdatesCommand}" Margin="0,0,8,0" />
                        <Button Content="선택 일괄 업데이트" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding UpdateSelectedModsCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Scope Selector Bar (Default: ts4script Core Mods Only) -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="불러올 대상:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="{Binding UpdateScriptScopeChipLabel}" GroupName="UpdScope" IsChecked="{Binding UpdateScope, Converter={StaticResource EqToBool}, ConverterParameter=ScriptCoreOnly}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="{Binding UpdateScriptAndXmlScopeChipLabel}" GroupName="UpdScope" IsChecked="{Binding UpdateScope, Converter={StaticResource EqToBool}, ConverterParameter=ScriptAndXml}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="{Binding UpdateAllScopeChipLabel}" GroupName="UpdScope" IsChecked="{Binding UpdateScope, Converter={StaticResource EqToBool}, ConverterParameter=AllMods}" />
                    </WrapPanel>
                    <TextBlock Grid.Column="2" Text="{Binding UpdateFilteredCountLabel}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Filter & Batch Select Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding UpdateSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="모드명, 제작자 또는 폴더명 검색"
                             Margin="0,0,10,0" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="전체" GroupName="UpdFilter" IsChecked="{Binding UpdateFilter, Converter={StaticResource EqToBool}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="업데이트 필요" GroupName="UpdFilter" IsChecked="{Binding UpdateFilter, Converter={StaticResource EqToBool}, ConverterParameter=UpdateNeeded}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="수동 확인" GroupName="UpdFilter" IsChecked="{Binding UpdateFilter, Converter={StaticResource EqToBool}, ConverterParameter=ManualCheck}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="유료 / 선배포" GroupName="UpdFilter" IsChecked="{Binding UpdateFilter, Converter={StaticResource EqToBool}, ConverterParameter=PaidOrEarly}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="링크 미발견" GroupName="UpdFilter" IsChecked="{Binding UpdateFilter, Converter={StaticResource EqToBool}, ConverterParameter=LinkNotFound}" />
                        <RadioButton Style="{StaticResource FilterChipRadioStyle}" Content="최신 상태" GroupName="UpdFilter" IsChecked="{Binding UpdateFilter, Converter={StaticResource EqToBool}, ConverterParameter=UpToDate}" />
                    </WrapPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="모두 선택" Style="{StaticResource SecondaryButtonStyle}" Padding="9,5" FontSize="12" Command="{Binding SelectAllUpdatesCommand}" Margin="0,0,5,0" />
                        <Button Content="필요 항목 선택" Style="{StaticResource SecondaryButtonStyle}" Padding="9,5" FontSize="12" Command="{Binding SelectUpdatableOnlyCommand}" Margin="0,0,5,0" />
                        <Button Content="선택 해제" Style="{StaticResource SecondaryButtonStyle}" Padding="9,5" FontSize="12" Command="{Binding ClearAllUpdatesCommand}" />
                    </StackPanel>
                </Grid>

                <!-- DataGrid + Right Detail Drawer -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding FilteredUpdateMods}"
                              SelectedItem="{Binding SelectedUpdateMod}"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="선택" Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="모드명" Binding="{Binding Name}" Width="1.35*" IsReadOnly="True" />
                            <DataGridTextColumn Header="제작자" Binding="{Binding CreatorName}" Width="0.85*" IsReadOnly="True" />
                            <DataGridTextColumn Header="유형" Binding="{Binding FunctionalCategoryShortLabel}" Width="0.78*" IsReadOnly="True" />
                            <DataGridTextColumn Header="폴더" Binding="{Binding FolderName}" Width="0.85*" IsReadOnly="True" />
                            <DataGridTextColumn Header="내 버전" Binding="{Binding LocalVersionDisplay}" Width="0.72*" IsReadOnly="True" />
                            <DataGridTextColumn Header="최신 버전" Binding="{Binding LatestVersion}" Width="0.78*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="상태" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusCode, Converter={StaticResource StatusBgConverter}}"
                                                CornerRadius="12"
                                                Padding="9,3"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Foreground="{Binding StatusCode, Converter={StaticResource StatusFgConverter}}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="작업" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="업데이트"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="8,4"
                                                    FontSize="11.5"
                                                    Margin="0,0,4,0"
                                                    Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.UpdateSingleModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="열기"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="8,4"
                                                    FontSize="11.5"
                                                    Visibility="{Binding HasPageUrl, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenPageUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Detail Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="선택 모드 상세 정보" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Text="목록에서 모드를 선택하면 매칭 정보와 배포처 링크가 표시됩니다."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding SelectedUpdateMod, Converter={StaticResource NullOrEmptyToVis}, ConverterParameter=Invert}" />

                                <StackPanel Visibility="{Binding SelectedUpdateMod, Converter={StaticResource NullOrEmptyToVis}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding SelectedUpdateMod.Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" TextWrapping="Wrap" />
                                        <Border Background="#1B3238" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding SelectedUpdateMod.IsPinned, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="📌 PIN" FontSize="10.5" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SelectedUpdateMod.CreatorName, StringFormat='제작자: {0}'}" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding SelectedUpdateMod.FunctionalSubCategory, StringFormat='분류: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding SelectedUpdateMod.MatchedCreator, StringFormat='원격 매칭 제작자: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" Visibility="{Binding SelectedUpdateMod.MatchedCreator, Converter={StaticResource NullOrEmptyToVis}}" />
                                    <TextBlock Text="{Binding SelectedUpdateMod.MatchStageDisplay, StringFormat='매칭 단계: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="개별 재조회" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CheckSingleModCommand}" CommandParameter="{Binding SelectedUpdateMod}" Margin="0,0,6,6" />
                                        <Button Content="URL 고정/수정" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PinUrlCommand}" CommandParameter="{Binding SelectedUpdateMod}" Margin="0,0,6,6" />
                                        <Button Content="폴더 열기" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenInExplorerCommand}" Margin="0,0,6,6" />
                                        <Button Content="브라우저 열기" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenPageUrlCommand}" CommandParameter="{Binding SelectedUpdateMod}" Visibility="{Binding SelectedUpdateMod.HasPageUrl, Converter={StaticResource BoolToVis}}" Margin="0,0,6,6" />
                                        <Button Content="다운로드 &amp; 업데이트" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding UpdateSingleModCommand}" CommandParameter="{Binding SelectedUpdateMod}" Visibility="{Binding SelectedUpdateMod.CanDownloadUpdate, Converter={StaticResource BoolToVis}}" Margin="0,0,6,6" />
                                    </WrapPanel>

                                    <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,0,10"
                                            Visibility="{Binding SelectedUpdateMod.VerificationNote, Converter={StaticResource NullOrEmptyToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="검증 노트 / 상태 설명" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedUpdateMod.VerificationNote}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,0,10"
                                            Visibility="{Binding SelectedUpdateMod.FailureReasonDisplay, Converter={StaticResource NullOrEmptyToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="실패 / 수동 확인 사유" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningAmberBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedUpdateMod.FailureReasonDisplay}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="배포처 페이지 URL" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedUpdateMod.PageUrl}" FontSize="11.5" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap" Margin="0,2,0,10" />

                                    <TextBlock Text="릴리스 노트 / 안내" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding SelectedUpdateMod.ReleaseNotes, Converter={StaticResource NullOrEmptyToVis}}" />
                                    <TextBlock Text="{Binding SelectedUpdateMod.ReleaseNotes}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,10" Visibility="{Binding SelectedUpdateMod.ReleaseNotes, Converter={StaticResource NullOrEmptyToVis}}" />

                                    <TextBlock Text="추가 검색 후보 링크" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,6" Visibility="{Binding SelectedUpdateMod.CandidateLinks.Count, Converter={StaticResource NullOrEmptyToVis}}" />
                                    <ItemsControl ItemsSource="{Binding SelectedUpdateMod.CandidateLinks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ElevatedCardStyle}" Padding="8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="열기" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"
                                                                Command="{Binding DataContext.OpenUrlDirectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Url}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB 3: BACKUP & RESTORE -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:MainTab.Backups}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="백업 &amp; 원클릭 복원 관리자" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="업데이트 전 자동 백업된 세션 및 수동 전체 백업을 조회하고, 문제가 생겼을 때 이전 상태로 안전하게 복원합니다."
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="목록 새로고침" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshBackupsCommand}" Margin="0,0,8,0" />
                        <Button Content="백업 폴더 열기" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenBackupsFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="지금 전체 수동 백업" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateManualBackupCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding BackupSessions}"
                              SelectedItem="{Binding SelectedBackup}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="백업 세션명" Binding="{Binding Name}" Width="1.8*" />
                            <DataGridTextColumn Header="생성 일시" Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="1.1*" />
                            <DataGridTextColumn Header="파일 수" Binding="{Binding FileCount}" Width="0.6*" />
                            <DataGridTextColumn Header="용량" Binding="{Binding TotalBytes, Converter={StaticResource BytesToReadable}}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="선택한 백업 세션 관리" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Text="왼쪽 목록에서 백업을 선택하면 포함된 항목과 복원·삭제 기능을 사용할 수 있습니다."
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding SelectedBackup, Converter={StaticResource NullOrEmptyToVis}, ConverterParameter=Invert}" />

                            <StackPanel Visibility="{Binding SelectedBackup, Converter={StaticResource NullOrEmptyToVis}}">
                                <TextBlock Text="{Binding SelectedBackup.Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedBackup.CreatedAt, StringFormat='생성 시각: {0:yyyy-MM-dd HH:mm:ss}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,2" />
                                <TextBlock Text="{Binding SelectedBackup.FileCount, StringFormat='포함 파일 수: {0}개'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="선택 백업으로 복원" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RestoreBackupCommand}" Margin="0,0,8,0" />
                                    <Button Content="세션 삭제" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteBackupCommand}" />
                                </StackPanel>

                                <TextBlock Text="최상위 백업 항목" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="6" Padding="8" MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SelectedBackup.TopLevelItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB 4: DIAGNOSTICS -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:MainTab.Diagnostics}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="정밀 스캔 검증 &amp; 개인정보 마스킹 진단 리포트" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Mods 내 모든 파일의 포함/제외/병합 사유를 100% 추적해 사각지대(미분류) 0건을 검증하고, PC 사용자명이 가려진 scan_report.txt를 생성합니다."
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="리포트 생성 / 갱신" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GenerateDiagnosticsCommand}" Margin="0,0,8,0" />
                        <Button Content="클립보드 복사" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,8,0" />
                        <Button Content="다른 이름으로 저장" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveDiagnosticsCommand}" />
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="미분류 사각지대" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ScanDiagnostics.UnaccountedFiles.Count, FallbackValue=0}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="CC / 제외 최상위폴더" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ScanDiagnostics.ExcludedTopFolders.Count, FallbackValue=0}" FontSize="22" FontWeight="Bold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="제외 보조 하위폴더" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ScanDiagnostics.ExcludedSubfolders.Count, FallbackValue=0}" FontSize="22" FontWeight="Bold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="다중 스크립트 폴더" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ScanDiagnostics.MultiScriptFolders.Count, FallbackValue=0}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="부속 파일 병합 그룹" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ScanDiagnostics.MergedUnitFiles.Count, FallbackValue=0}" FontSize="22" FontWeight="Bold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10">
                    <TextBox Text="{Binding DiagnosticReportText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="Consolas, Malgun Gothic"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Border>
            </Grid>

            <!-- TAB 5: CATALOG & SETTINGS -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:MainTab.Settings}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="내장 카탈로그 &amp; 환경설정" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Mods 경로·백업·병렬 조회 설정을 변경하고, 내장된 84+ 공식 모드 카탈로그와 고정(Pinned) URL 목록을 관리합니다."
                               FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Settings + Pinned Manifest -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="환경설정 (config.json)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                                <TextBlock Text="심즈 4 Mods 폴더 경로" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ModsFolderDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" Content="자동 탐지" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DetectModsFolderCommand}" Margin="0,0,6,0" />
                                    <Button Grid.Column="2" Content="찾아보기" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseModsFolderCommand}" />
                                </Grid>

                                <TextBlock Text="백업 저장 루트 폴더" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding BackupFolderDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" Content="찾아보기" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseBackupFolderCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="업데이트 설치 전 자동 백업 실행 (권장)" IsChecked="{Binding AutoBackupDraft}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="병렬 동시 조회 수:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Width="48" Text="{Binding MaxConcurrentChecksDraft, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Button Content="설정 저장 및 Mods 재스캔" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>

                        <!-- Pinned Manifest Entries -->
                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding PinnedEntries.Count, StringFormat='고정된 배포처 URL 목록 ({0}개)'}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding PinnedEntries}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="모드명" Binding="{Binding Name}" Width="1.1*" />
                                        <DataGridTextColumn Header="고정 URL" Binding="{Binding PinnedPageUrl}" Width="1.6*" />
                                        <DataGridTemplateColumn Header="" Width="82">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="해제" Style="{StaticResource DangerButtonStyle}" Padding="8,3" FontSize="11.5"
                                                            Command="{Binding DataContext.RemoveManifestPinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right: Built-in Known Catalog Browser -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding FilteredCatalogItems.Count, StringFormat='내장 공식 모드 카탈로그 ({0}개 항목)'}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBox Grid.Row="1" Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="카탈로그 이름, 제작자 또는 키워드 검색" Margin="0,0,0,10" />
                            <ListBox Grid.Row="2" ItemsSource="{Binding FilteredCatalogItems}" Padding="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,0,8" Padding="10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Creator, StringFormat='  by {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ReleaseNotes}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,5"
                                                           Visibility="{Binding ReleaseNotes, Converter={StaticResource NullOrEmptyToVis}}" />
                                                <ItemsControl ItemsSource="{Binding Links}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <TextBlock Text="{Binding Label, StringFormat='[{0}] '}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                                                                <Button Content="{Binding Url}"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Padding="6,2" FontSize="11"
                                                                        Command="{Binding DataContext.OpenUrlDirectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding Url}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Global Status & Progress Footer -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1"
                             Minimum="0"
                             Maximum="{Binding ProgressMaximum}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Margin="14,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="2"
                        Content="작업 중단"
                        Style="{StaticResource DangerButtonStyle}"
                        Padding="10,4"
                        FontSize="12"
                        Command="{Binding CancelOperationCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
