<Window x:Class="Sims4ModUpdater.Views.AssignCreatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="제작자 지정 / 이름 변경"
        Width="520"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtDialogTitle" Grid.Row="0" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="TxtTargetInfo" Grid.Row="1" Margin="0,6,0,12" FontSize="12.5" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="제작자 이름 입력 (기존 제작자 클릭 또는 새 이름 직접 입력)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="TxtCreatorInput" Height="38" TextChanged="OnInputTextChanged" />
            <TextBlock x:Name="TxtAutoHint" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="현재 목록의 제작자 빠른 선택 (클릭 시 입력란에 채워집니다)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,6" />

        <ListBox x:Name="LstExistingCreators"
                 Grid.Row="4"
                 Padding="4"
                 SelectionChanged="OnCreatorSelectionChanged"
                 MouseDoubleClick="OnCreatorDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,5">
                        <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnRevert"
                    Grid.Column="0"
                    Content="자동 감지로 되돌리기"
                    Style="{StaticResource DangerButtonStyle}"
                    Visibility="Collapsed"
                    Click="OnRevertClick" />

            <Button Grid.Column="2" Content="취소" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsCancel="True" />
            <Button Grid.Column="3" Content="적용 저장" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnSaveClick" />
        </Grid>
    </Grid>
</Window>
