<Window x:Class="Sims4ModUpdater.Views.OrganizeByCreatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mods 폴더 제작자별 자동 정리 (폴더 맞추기)"
        Width="920"
        Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Mods 폴더 제작자별 자동 정리 (폴더 맞추기)" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="모드 탐색기에서 정리한 제작자 기준에 맞춰 실제 Mods 폴더 내부 구조를 정리합니다. 심즈 4 스크립트(.ts4script)의 1단계 깊이 제한을 자동으로 지킵니다."
                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Layout Selection -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,12">
            <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <RadioButton x:Name="RbSingleCreatorFolder"
                                 GroupName="OrgLayout"
                                 IsChecked="True"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontWeight="SemiBold"
                                 FontSize="13.5"
                                 Content="제작자 단일 폴더로 합치기 (Mods\제작자\파일)"
                                 Checked="OnOptionChanged" />
                    <TextBlock Text="예: Mods\Deaderpool\mc_cmd_center.ts4script — 제작자당 폴더 1개로 통합하며 1단계 깊이를 유지합니다. 파일명이 겹치면 안전하게 건너뜁니다."
                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="20,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ElevatedCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <RadioButton x:Name="RbPrefixedModFolder"
                                 GroupName="OrgLayout"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontWeight="SemiBold"
                                 FontSize="13.5"
                                 Content="제작자 접두사 폴더로 구분 (Mods\[제작자] 모드명\)"
                                 Checked="OnOptionChanged" />
                    <TextBlock Text="예: Mods\[Deaderpool] MCCC\... — 모드별 폴더가 섞이지 않고 파일명 충돌 없이 제작자 이름순 정렬 + 1단계 깊이를 보장합니다."
                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="20,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Safety Options -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="ChkSkipUnknown"
                      Content="미분류(제작자 불명) 모드는 이동하지 않고 현재 위치 유지 (권장)"
                      IsChecked="True"
                      Margin="0,0,20,0"
                      Checked="OnOptionChanged"
                      Unchecked="OnOptionChanged" />
            <CheckBox x:Name="ChkCreateBackup"
                      Content="폴더 이동 전 백업 세션 자동 생성 (강력 권장)"
                      IsChecked="True" />
        </StackPanel>

        <!-- Live Preview Summary Banner -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtPlanSummary" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtConflictNotice" Grid.Column="1" FontSize="12" Foreground="{StaticResource WarningAmberBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Move Plan DataGrid -->
        <DataGrid x:Name="GridPreview" Grid.Row="4" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="모드 / 항목" Binding="{Binding ModName}" Width="1.15*" />
                <DataGridTextColumn Header="제작자" Binding="{Binding Creator}" Width="0.8*" />
                <DataGridTextColumn Header="현재 경로" Binding="{Binding SourceRelativePath}" Width="1.35*" />
                <DataGridTextColumn Header="정리 후 경로" Binding="{Binding TargetRelativePath}" Width="1.35*" />
                <DataGridTextColumn Header="상태" Binding="{Binding StatusNote}" Width="0.95*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="BtnExecute" Content="미리보기 대로 폴더 정리 실행" Style="{StaticResource PrimaryButtonStyle}" Click="OnExecuteClick" />
        </StackPanel>
    </Grid>
</Window>
