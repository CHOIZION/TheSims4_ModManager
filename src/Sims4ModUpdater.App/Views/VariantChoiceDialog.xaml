<Window x:Class="Sims4ModUpdater.Views.VariantChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="에디션 / 파일 변형 선택"
        Width="560"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="다운로드할 파일 / 에디션 선택" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="TxtDescription"
                   Grid.Row="1"
                   Margin="0,6,0,12"
                   FontSize="12.5"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap" />

        <ListBox x:Name="LstVariants"
                 Grid.Row="2"
                 Padding="6"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,7" Margin="0,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FileName}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="선택한 파일로 업데이트" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
