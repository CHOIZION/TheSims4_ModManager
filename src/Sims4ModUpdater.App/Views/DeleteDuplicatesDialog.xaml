<Window x:Class="Sims4ModUpdater.Views.DeleteDuplicatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="중복 파일 일괄 삭제 (백업 후 안전 정리)"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="중복 모드 파일 일괄 삭제" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="유지 우선순위: 1) Overrides 폴더  ›  2) 제작자 정리 폴더  ›  3) 복사본((1), _Copy 등)이 아닌 원본 이름  ›  4) 최신 수정 파일. 삭제 전에 선택한 파일만 백업 세션에 보관한 뒤 제거합니다."
                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Detection & Safety Options -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="ChkIncludeHashDuplicates"
                      Content="파일명이 달라도 내용(SHA-256)이 100% 동일한 중복 파일 포함"
                      IsChecked="True"
                      Margin="0,2,22,2"
                      Checked="OnOptionChanged"
                      Unchecked="OnOptionChanged" />
            <CheckBox x:Name="ChkCreateBackup"
                      Content="삭제 전 백업 세션 자동 생성 (복원 가능, 강력 권장)"
                      IsChecked="True"
                      Margin="0,2,0,2" />
        </WrapPanel>

        <!-- Summary + Quick Selection Bar -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtSummary"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="전체 선택" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,5" Click="OnSelectAllClick" />
                    <Button Content="내용 일치만 선택" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,5" Click="OnSelectExactOnlyClick" />
                    <Button Content="전체 해제" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Click="OnClearAllClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Duplicate Preview DataGrid -->
        <DataGrid x:Name="GridDuplicates"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="삭제" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="판정 기준" Binding="{Binding MatchType}" Width="0.85*" IsReadOnly="True" />
                <DataGridTextColumn Header="보존할 원본 (유지)" Binding="{Binding KeepRelativePath}" Width="1.45*" IsReadOnly="True" />
                <DataGridTextColumn Header="삭제될 중복 파일" Binding="{Binding DeleteRelativePath}" Width="1.45*" IsReadOnly="True" />
                <DataGridTextColumn Header="크기" Binding="{Binding FileSizeDisplay}" Width="0.55*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer Buttons -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtFooterWarning"
                       Text="보존할 원본 파일은 항상 1개 이상 남기며, Resource.cfg 및 핵심 시스템 파일은 삭제 대상에서 제외됩니다."
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="취소" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="BtnExecute"
                        Content="선택한 중복 파일 일괄 삭제"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="OnExecuteClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
