<Application x:Class="Sims4ModUpdater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Sims4ModUpdater.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
            <infra:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis" />
            <infra:BytesToReadableConverter x:Key="BytesToReadable" />
            <infra:StatusCodeToBackgroundConverter x:Key="StatusBgConverter" />
            <infra:StatusCodeToForegroundConverter x:Key="StatusFgConverter" />
            <infra:EqualityToBoolConverter x:Key="EqToBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
